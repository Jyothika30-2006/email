# ── LLM (local only; the agent talks to Ollama on your machine, never to a cloud API) ──
export SENTINEL_MODEL="llama3.1:8b"           # or qwen2.5:7b — anything with tool calling
export OLLAMA_HOST="http://127.0.0.1:11434"      # the address Ollama listens on
export SENTINEL_OFFLINE="0"                    # 1 → skip Ollama entirely, use the deterministic engine
# export SENTINEL_LLM_TIMEOUT="90"

# ── SAFETY (these five are the non-negotiables — see README §6) ───────────────
export SENTINEL_TOOL_TIMEOUT="15"              # SAFETY #5: hard cap per tool call
export SENTINEL_REQUIRE_CONFIRMATION="1"       # SAFETY #4: human 'yes' before file-touching tools
export SENTINEL_CONFIRM_TIMEOUT="120"           # no answer in time → DENY (fail closed)
export SENTINEL_KILL_KEY="x"                    # SAFETY #8: single keypress aborts agent + sandbox
export SENTINEL_SANDBOX_REQUIRED="0"           # 1 → refuse to run when Docker is unavailable

# ── sandbox resource limits (applied to `docker run`) ─────────────────────────
export SENTINEL_SANDBOX_IMAGE="sentinel-sandbox:latest"
export SENTINEL_SANDBOX_MEMORY="512m"
export SENTINEL_SANDBOX_CPUS="1.0"
export SENTINEL_SANDBOX_PIDS="128"
export SENTINEL_SANDBOX_TMPFS="64m"

# ── reputation APIs (free tiers; leave unset and those checks report 'unobserved') ──
# export VIRUSTOTAL_API_KEY=""
# export ABUSEIPDB_API_KEY=""
# export IPINFO_TOKEN=""

# ── geolocation ───────────────────────────────────────────────────────────────
# Offline MaxMind DB (no network at all, best privacy):
export GEOIP_MMDB="$HOME/.local/share/GeoIP/GeoLite2-City.mmdb"
# export SENTINEL_GEO_BASE_URL=""               # demos/tests: local mock from `mock-apis`
# export SENTINEL_REPUTATION_BASE_URL=""       # same, for VirusTotal/AbuseIPDB shapes
# export SENTINEL_GEO_ALLOW_PRIVATE="0"        # 1 only for the sample corpus / CI

# ── evidence log ───────────────────────────────────────────────────────────────
export SENTINEL_CHAIN_BACKEND="auto"           # auto | hashchain | ganache
export SENTINEL_CHAIN_PATH="evidence/hashchain.jsonl"
export SENTINEL_HEAD_PATH="evidence/HEAD.json"
# export GANACHE_RPC_URL="http://127.0.0.1:8545"
# export SENTINEL_ETH_PRIVATE_KEY=""           # only needed to sign without a node account
# export SENTINEL_CONTRACT_ADDRESS=""           # skip deploy if already on the chain

# ── Tor + DNS determinism for demos/CI (never enable the fixtures in production) ──
# export SENTINEL_TOR_EXITLIST="/path/to/exitlist.txt"    # cached bulk list cross-check
# export SENTINEL_DNS_FIXTURES="samples/fixtures/dns_fixtures.json"
# export SENTINEL_TOR_EXIT_FIXTURE="samples/fixtures/tor_exit_ips.txt"

# ── contract address for the optional on-chain mirror ─────────────────────────
# export SENTINEL_CONTRACT_ADDRESS="0x…"     # produced by: ./scripts/compile_contract.sh
# export SENTINEL_CONTRACT_ARTIFACT=""       # explicit path to a compiled artifact JSON
